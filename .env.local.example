# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# Pick your own passphrase — used to unlock /admin and call /api/admin/* routes
ADMIN_DASHBOARD_KEY=choose-a-strong-passphrase

# Gate codes required at /register/judge, /register/committee, and
# /register/participant — give these out to the people who should actually
# be able to check in under those roles. Participant check-in also requires
# the name + team to already be in the database (from the imported roster) —
# no on-the-fly team/person creation any more.
JUDGE_ACCESS_KEY=choose-a-judge-access-key
COMMITTEE_ACCESS_KEY=choose-a-committee-access-key
PARTICIPANT_ACCESS_KEY=choose-a-participant-access-key
